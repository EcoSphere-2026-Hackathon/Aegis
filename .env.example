# AEGIS configuration.
#
# Copy to .env and fill in. Everything here has a working default except the
# credentials, so the text-only pipeline and the console run with no setup at
# all -- `python run.py` works on a clean checkout.
#
# Never commit the real .env. Secrets stay backend-side: nothing in this file
# is ever sent to the browser or written to a log.

# ── Agora ────────────────────────────────────────────────────────────────
# Needed only for live voice. Without them the console, the reasoning loop
# and the text channel all still work; only /join and /speak fail.

AGORA_APP_ID=
AGORA_CHANNEL_NAME=aegis-incident

# Basic Auth for the REST API. Console → Developer Toolkit → RESTful API.
# These are NOT the App Certificate: that signs RTC tokens and will return
# 401 here, in a way that looks like a typo. Confirm this pair exists before
# the first live run -- it is the one credential that can block the demo.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

AGORA_AGENT_UID=9000
AGENT_METRICS_ENABLED=true

# ── Extraction ───────────────────────────────────────────────────────────
# `deterministic` is the offline rule-based extractor: no key, no network,
# and it carries the golden demo unaided. Switch to `openai_compatible` for
# LLM extraction against any vendor speaking /chat/completions.

LLM_PROVIDER=deterministic
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=6
LLM_MAX_ATTEMPTS=2
LLM_TEMPERATURE=0

# Set only if the chosen provider genuinely supports vision. Left blank the
# screenshot path stays off rather than silently substituting a model that
# cannot read an image.
LLM_VISION_MODEL=

# ── Intervention pacing ──────────────────────────────────────────────────
# 45s is an architectural constant, not a tuning knob. Lower it only to
# compress a rehearsal; the startup banner warns when it is not 45.

GOVERNOR_RATE_LIMIT_SECONDS=45

# ── Server ───────────────────────────────────────────────────────────────
# Set a token before exposing the server beyond localhost. The ingestion
# endpoints accept confirmation claims, and a confirmation is what makes an
# action authorised -- leaving them open is the one security hole this
# product actually has.

AEGIS_HOST=127.0.0.1
AEGIS_PORT=8080
AEGIS_INGEST_TOKEN=
AEGIS_INGEST_RPM=600

# Both pages are served by this process from the same origin and call the API
# with relative paths, so there is no frontend base URL to configure and CORS
# is off by default. Set this only if you serve frontend/ from somewhere else
# -- a comma-separated origin list, never "*", because these endpoints accept
# confirmation claims.
AEGIS_CORS_ORIGINS=

# ── Runtime ──────────────────────────────────────────────────────────────

AEGIS_INCIDENT_ID=incident-local
AEGIS_DB_PATH=data/incident.db
AEGIS_LOG_LEVEL=INFO
# Structured JSON logs, one object per line. This file is the input to the
# evaluation harness, so keep it if you want to reconstruct a rehearsal.
AEGIS_LOG_FILE=data/aegis.log
