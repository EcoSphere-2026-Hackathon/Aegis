# Secrets. The one file that must never be committed.
.env
*.pem
*.key

# Runtime state and logs. The incident database is a per-run artefact; the
# structured log is the evaluation harness's input and can get large.
data/*.db
data/*.db-wal
data/*.db-shm
data/*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Transfer artefacts
*.tar.gz

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
