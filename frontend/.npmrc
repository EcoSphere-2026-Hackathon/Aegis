# agora-rtm@2.2.4 declares an exact peer on agora-rtc-sdk-ng@4.23.0, while
# agora-agent-client-toolkit@1.2.0 requires >=4.23.4. The two cannot both be
# satisfied, so a plain `npm install` and even `npm ci` fail with ERESOLVE and
# the voice bundle cannot be rebuilt at all.
#
# This reproduces the dependency tree the committed bundle was actually built
# and tested against. Revisit when Agora publishes an rtm release whose peer
# range overlaps the toolkit's -- at that point this file should be deleted
# rather than carried forward.
legacy-peer-deps=true
